        "url": "git+https://github.com/LuXDAmore/portfolio"
    },
    "bugs": {
        "url": "https://github.com/LuXDAmore/portfolio/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "nuxt.config.js",
        ".nuxt",
        ".output",
        "dist"
    ],
    "type": "module",
    "main": "nuxt.config.js",
    "scripts": {
        "check:eslint-config": "cross-env TIMING=1 pnpm eslint:fix",
        "typecheck": "nuxi typecheck",
        "analyze": "nuxi analyze",
        "build:profile": "nuxi build --profile",
        "build": "nuxi build",
        "nuxt:upgrade": "nuxi upgrade --force",
        "dev": "nuxi dev -o",
        "generate": "nuxi generate",
        "preview": "nuxi preview",
        "clean": "nuxi cleanup",
        "prepare": "nuxi prepare",
        "start": "nuxi start",
        "postinstall": "pnpm prepare",
        "eslint:check": "eslint .",
        "eslint:fix": "eslint --fix .",
        "lint": "pnpm eslint:check && pnpm stylelint:check",
        "lint:fix": "pnpm eslint:fix && pnpm stylelint:fix",
        "lint:check": "pnpm eslint:check && pnpm stylelint:check",
        "stylelint:check": "pnpm stylelint:check:scss",
        "stylelint:check:css": "stylelint \"**/*.css\"",
        "stylelint:check:scss": "stylelint \"**/*.scss\"",
        "stylelint:check:vue": "stylelint \"**/*.vue\"",
        "stylelint:fix": "pnpm stylelint:fix:scss",
        "stylelint:fix:css": "stylelint \"**/*.css\" --fix",
        "stylelint:fix:scss": "stylelint  \"**/*.scss\" --fix",
        "stylelint:fix:vue": "stylelint \"**/*.vue\" --fix",
        "test:nuxt": "vitest --project nuxt",
        "test:unit": "vitest --project unit",
        "test:all": "vitest",
        "test:dev": "vitest --watch",
        "test": "echo 'Error: no test specified' && exit 0",
        "font-download": "node ./scripts/font-download.js",
        "backup": "node ./scripts/backup.js",
        "release": "node ./scripts/release.js",
        "release:post-version": "pnpm version:generate-changelog && pnpm generate:vpn && pnpm backup && pnpm release && git add -A && git commit -am \"chore(release): new version released\" && git push --follow-tags origin main && git push",
        "release:patch": "pnpm version:patch && pnpm release:post-version",
        "release:minor": "pnpm version:minor && pnpm release:post-version",
        "release:major": "pnpm version:major && pnpm release:post-version",
        "version:generate-changelog": "standard-version --skip.bump --skip.commit --skip.tag",
        "version:patch": "standard-version --release-as patch",
        "version:minor": "standard-version --release-as minor",
        "version:major": "standard-version --release-as major"
    },
    "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
